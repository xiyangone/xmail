{
  "name": "xmail",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "build:worker": "opennextjs-cloudflare build",
    "db:migrate-local": "tsx scripts/migrate.ts local",
    "db:migrate-remote": "tsx scripts/migrate.ts remote",
    "webhook-test-server": "bun run scripts/webhook-test-server.ts",
    "generate-test-data": "wrangler dev scripts/generate-test-data.ts",
    "dev:cleanup": "wrangler dev --config wrangler.cleanup.json --test-scheduled",
    "test:cleanup": "curl http://localhost:8787/__scheduled",
    "test:api": "tsx scripts/api-smoke-test.ts",
    "test:api-contract": "tsx scripts/tests/api-response-contract.test.ts",
    "test:verification-code": "tsx scripts/tests/verification-code-fetcher.test.ts",
    "test:realtime": "tsx scripts/tests/realtime-token.test.ts && tsx scripts/tests/realtime-client.test.ts",
    "test:permissions": "tsx scripts/tests/permission-grants.test.ts && tsx scripts/tests/route-policy.test.ts && tsx scripts/tests/api-key-policy.test.ts && tsx scripts/tests/permission-seed-sql.test.ts",
    "test:operations": "tsx scripts/tests/operations-log.test.ts && tsx scripts/tests/admin-dashboard-tabs.test.ts && tsx scripts/tests/admin-audit-integration.test.ts && tsx scripts/tests/docs-i18n.test.ts",
    "test:maintainability": "tsx scripts/tests/maintainability-refactor.test.ts && tsx scripts/tests/email-sender.test.ts && tsx scripts/tests/email-expiry.test.ts && tsx scripts/tests/realtime-token.test.ts && tsx scripts/tests/realtime-client.test.ts && tsx scripts/tests/api-response-contract.test.ts",
    "deploy:email": "wrangler deploy --config wrangler.email.json",
    "deploy:cleanup": "wrangler deploy --config wrangler.cleanup.json",
    "deploy:worker": "pnpm run verify && pnpm run build:worker && wrangler deploy --keep-vars",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test --test-concurrency=1 scripts/tests/*.test.ts",
    "test:performance": "tsx --test --test-concurrency=1 scripts/tests/request-control.test.ts scripts/tests/navigation-performance.test.ts scripts/tests/auth-performance.test.ts scripts/tests/config-store.test.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "type": "module",
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@opennextjs/cloudflare": "1.20.6",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.6",
    "next-themes": "0.4.6",
    "postal-mime": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun": "1.4.2",
    "cloudflare": "7.1.0",
    "dotenv": "18.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.136.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
