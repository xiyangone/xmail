{
  "name": "xmail",
  "version": "1.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "build:worker": "npx opennextjs-cloudflare build",
    "db:migrate-local": "tsx scripts/migrate.ts local",
    "db:migrate-remote": "tsx scripts/migrate.ts remote",
    "webhook-test-server": "bun run scripts/webhook-test-server.ts",
    "generate-test-data": "wrangler dev scripts/generate-test-data.ts",
    "dev:cleanup": "wrangler dev --config wrangler.cleanup.json --test-scheduled",
    "test:cleanup": "curl http://localhost:8787/__scheduled",
    "test:api": "tsx scripts/api-smoke-test.ts",
    "test:verification-code": "tsx scripts/tests/verification-code-fetcher.test.ts",
    "test:permissions": "tsx scripts/tests/permission-grants.test.ts && tsx scripts/tests/route-policy.test.ts && tsx scripts/tests/api-key-policy.test.ts && tsx scripts/tests/permission-seed-sql.test.ts",
    "test:operations": "tsx scripts/tests/operations-log.test.ts && tsx scripts/tests/admin-dashboard-tabs.test.ts && tsx scripts/tests/admin-audit-integration.test.ts && tsx scripts/tests/docs-i18n.test.ts",
    "test:maintainability": "tsx scripts/tests/maintainability-refactor.test.ts && tsx scripts/tests/email-sender.test.ts && tsx scripts/tests/email-expiry.test.ts",
    "deploy:email": "wrangler deploy --config wrangler.email.json",
    "deploy:cleanup": "wrangler deploy --config wrangler.cleanup.json",
    "deploy:worker": "pnpm run build:worker && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "15.5.19",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "postal-mime": "^2.7.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.1",
    "@eslint/eslintrc": "^3.3.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "bun": "^1.3.14",
    "cloudflare": "^6.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  }
}
